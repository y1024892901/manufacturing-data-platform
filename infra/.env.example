# ============================================================
# 环境变量模板 —— 复制为 .env 后填入真实值
#   cp .env.example .env
# .env 已被 .gitignore 排除，绝不入库
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=mfg_admin
POSTGRES_PASSWORD=change_me_in_local_env

# 数仓库（ODS/DWD/DWS/ADS 四层）
WAREHOUSE_DB=warehouse
# 管理后台元数据库（与数仓物理隔离）
META_DB=platform_meta
# AI 向量库与会话库（pgvector）
APP_DB=app_meta

# MCP 专用只读账号（只有 SELECT 权限，见 infra/db-init/）
MCP_RO_USER=mcp_readonly
MCP_RO_PASSWORD=change_me_too

# ---------- LLM（国内模型）----------
# 主供应商：DeepSeek
LLM_PRIMARY=deepseek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 备用供应商：千问 Qwen（主供应商失败时自动降级）
LLM_FALLBACK=qwen
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 嵌入模型（语义层用）
EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL=text-embedding-v3

# ---------- 服务端口 ----------
API_PORT=8000
REPORT_WEB_PORT=5173
ADMIN_WEB_PORT=5174
DAGSTER_PORT=3000
MCP_PORT=8001

# ---------- 运行环境 ----------
ENV=dev
LOG_LEVEL=INFO
# 演示模式：关闭自动调度，避免后台任务干扰演示
DEMO_MODE=true

# ---------- 告警（可选）----------
WECOM_WEBHOOK_URL=
DINGTALK_WEBHOOK_URL=
