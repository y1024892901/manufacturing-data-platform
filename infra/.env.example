# ============================================================
# 环境变量模板 —— 复制为 .env 后填入真实值
#   cp .env.example .env
# .env 已被 .gitignore 排除，绝不入库
# ============================================================

# ---------- 数据库连接（本机 MySQL 8 实例）----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me_in_local_env
# MySQL 安装目录（供管理脚本与演示脚本调用 mysql.exe）
MYSQL_HOME=D:/mysql8

# ---------- 业务库（对应 infra/db-init/01_databases.sql）----------
SRC_MDM_DB=src_mdm
SRC_CRM_DB=src_crm
SRC_ERP_DB=src_erp
SRC_PLM_DB=src_plm
SRC_SRM_DB=src_srm
SRC_WMS_DB=src_wms
SRC_MES_DB=src_mes
SRC_QMS_DB=src_qms
SRC_EAM_DB=src_eam
SRC_ENERGY_DB=src_energy

# ---------- 数仓四层（P6 阶段使用，当前暂缓）----------
DW_ODS_DB=mfg_ods
DW_DWD_DB=mfg_dwd
DW_DWS_DB=mfg_dws
DW_ADS_DB=mfg_ads

# ---------- 平台库 ----------
AUTH_DB=mfg_auth
META_DB=mfg_meta
APP_DB=mfg_app
OPS_DB=mfg_ops

# ---------- 安全 ----------
# JWT 签名密钥，至少 32 字节；不要使用示例值
JWT_SECRET=change_me_to_a_random_string_at_least_32_bytes

# ---------- LLM（P7 阶段使用，当前暂缓）----------
# 主供应商：DeepSeek
LLM_PRIMARY=deepseek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 备用供应商：千问 Qwen（主供应商失败时自动降级）
LLM_FALLBACK=qwen
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ---------- 服务端口 ----------
SOURCE_API_PORT=8080
SOURCE_WEB_PORT=5173
API_PORT=8000
REPORT_WEB_PORT=5174
ADMIN_WEB_PORT=5175
DAGSTER_PORT=3000
MCP_PORT=8001

# ---------- 运行环境 ----------
ENV=dev
LOG_LEVEL=INFO
# 演示模式：关闭自动调度，避免后台任务干扰演示
DEMO_MODE=true
